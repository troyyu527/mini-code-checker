# Local settings for wrangler dev and the CLI jobs. Copy to .env (ignored by git). No real secrets here.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gemma4:12b
OLLAMA_EMBEDDING_MODEL=hf.co/CompendiumLabs/bge-small-en-v1.5-gguf:Q8_0
# The clause file stays outside the repo: the code text is (c) ICC (quote briefly, with a citation)
CLAUSES_PATH=F:/Practice/data/clauses.jsonl
# Optional: tiny limits to try the budget guard
# DAILY_TOKEN_LIMIT=2000
# SESSION_MESSAGE_LIMIT=2
