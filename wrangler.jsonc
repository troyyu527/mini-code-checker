// Cloudflare Worker config: the Mini Code Checker API.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-code-checker",
  "main": "server/main.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionAgent" },
      { "name": "BUDGET", "class_name": "BudgetGuard" }
    ]
  },
  // add a new tag for each change; never edit a tag that has been deployed
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["BudgetGuard"] }
  ],
  // lesson 39 replaces the zero id with the id that `wrangler d1 create` prints
  "d1_databases": [{ "binding": "DB", "database_name": "mini-code-checker", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "AI_PROVIDER": "ollama"
  }
}